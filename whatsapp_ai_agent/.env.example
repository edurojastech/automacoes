# Anthropic (motor do agente de IA)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Evolution API (servidor self-hosted de WhatsApp: https://github.com/EvolutionAPI/evolution-api)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
# Segredo proprio (nao vem da Evolution) usado para proteger a URL do webhook.
# Gere uma string aleatoria e use a mesma no query param ?secret= da URL
# configurada em cada instance.
EVOLUTION_WEBHOOK_SECRET=escolha-uma-string-secreta-aqui

# Google Calendar (Service Account)
# Baixe o JSON da conta de servico e compartilhe cada calendario da clinica
# com o e-mail dessa conta de servico (permissao "Fazer alteracoes em eventos").
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json

# Banco local (historico de conversas por paciente)
DATABASE_PATH=./data/conversas.db

# Servidor
PORT=8000
